[TEMPLATE]
# ─── Base de datos MySQL ───
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=techpc_db
DB_PORT=3306

# ─── Servidor ───
PORT=8000

# ─── Seguridad JWT ───
JWT_SECRET=tu_secreto_super_seguro

# ─── CORS ───
# Orígenes permitidos separados por coma. Usa * solo en desarrollo.
# En producción coloca la URL pública del frontend, por ejemplo:
# CORS_ORIGINS=https://techpc-frontend.up.railway.app,http://localhost:5173
CORS_ORIGINS=*

# ─── Envío de correos (SMTP) ───
# Notificación de compra, factura en PDF y recuperación de contraseña.
# Para Gmail: activa la verificación en dos pasos de la cuenta y genera una
# "Contraseña de aplicaciones" (16 caracteres) en https://myaccount.google.com/apppasswords
# Si SMTP_USER y SMTP_PASSWORD quedan vacíos, la API funciona normal pero no
# envía correos (los registra en el log del servidor).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
# Remitente visible (opcional; por defecto usa SMTP_USER)
SMTP_FROM=
SMTP_FROM_NAME=TechPC - Tienda de Tecnología
# STARTTLS para el puerto 587 (true). Para el puerto 465 usa SMTP_SSL=true y SMTP_TLS=false
SMTP_TLS=true
SMTP_SSL=false
# Correo que recibe copia de cada venta (opcional)
EMAIL_COPIA_VENTAS=

# URL pública del Frontend (se usa en los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# ─── Chatbot con Inteligencia Artificial ───
# IMPORTANTE: esta clave NUNCA se sube a GitHub ni se escribe en el código.
# Si se deja vacía, el chatbot responde con el motor local de reglas
# (preguntas frecuentes, productos, servicios, compras y PQR).
IA_API_KEY=
# Proveedor compatible con OpenAI (OpenAI, Groq, OpenRouter, etc.)
IA_BASE_URL=https://api.openai.com/v1
IA_MODEL=gpt-4o-mini
# Tiempo máximo de espera de la respuesta de IA (segundos)
IA_TIMEOUT=20
