    {
      "name": "📨 Módulo PQR (Quinto Avance)",
      "description": "Registro y gestión de Peticiones, Quejas y Reclamos.",
      "item": [
        {
          "name": "Registrar PQR 🔐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.pqr) {",
                  "  pm.collectionVariables.set('pqrId', data.pqr.id);",
                  "  pm.test('PQR registrada en estado pendiente', function () { pm.expect(data.pqr.estado).to.eql('pendiente'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"queja\",\n  \"asunto\": \"Retraso en la entrega del pedido\",\n  \"descripcion\": \"El pedido fue despachado con dos días de retraso y necesito conocer el motivo.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pqr",
              "host": ["{{baseUrl}}"],
              "path": ["pqr"]
            }
          },
          "response": []
        },
        {
          "name": "Listar PQR 🔐",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/pqr?estado=pendiente",
              "host": ["{{baseUrl}}"],
              "path": ["pqr"],
              "query": [{ "key": "estado", "value": "pendiente" }]
            }
          },
          "response": []
        },
        {
          "name": "Consultar PQR por ID 🔐",
