    {
      "name": "🔐 Autenticación y Usuarios",
      "description": "Registro, login JWT y gestión de usuarios.",
      "item": [
        {
          "name": "Registrar usuario (cliente) ❌",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"1098765432\",\n  \"direccion\": \"Cra 10 # 20-30, Bogotá\",\n  \"telefono\": \"3101234567\",\n  \"correo\": \"juan@ejemplo.com\",\n  \"contrasena\": \"MiPass123*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/registro",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "registro"]
            }
          },
          "response": []
        },
        {
          "name": "Login (genera JWT) ❌",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  if (data.user) {",
                  "    pm.collectionVariables.set('userId', data.user.id);",
                  "  }",
                  "  pm.test('Login exitoso - JWT generado', function () { pm.expect(data.token).to.be.a('string'); });",
                  "  console.log('✅ Token guardado. Rol: ' + (data.user ? data.user.rol : 'N/A'));",
                  "} else {",
                  "  console.error('❌ No se recibió token.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@techpc.com\",\n  \"contrasena\": \"Admin123*\"\n}"
            },
            "url": {
